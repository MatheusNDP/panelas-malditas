[connection signal="pressed" from="Pausa/Anterior" to="Pausa" method="virar" binds= [-1]]
[connection signal="pressed" from="Pausa/Proxima" to="Pausa" method="virar" binds= [1]]
[connection signal="timeout" from="PowerUps" to="." method="_on_power_ups_timeout"]
